# NEMESIS-X Environment Configuration (Phase 1)

# PostgreSQL
POSTGRES_USER=nemesis
POSTGRES_PASSWORD=nemesis_secret_password
POSTGRES_DB=nemesis_x
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg2://nemesis:nemesis_secret_password@postgres:5432/nemesis_x
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend
VITE_API_BASE_URL=http://localhost:8000
